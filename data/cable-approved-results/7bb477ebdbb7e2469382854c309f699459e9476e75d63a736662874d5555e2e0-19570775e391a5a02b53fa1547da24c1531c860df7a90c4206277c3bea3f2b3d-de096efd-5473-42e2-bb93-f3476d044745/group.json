  "multicoreComposition": {
    "version": "multicore-composition-1.0.0",
    "frame": "Vertically balance the entire visible silhouette around the canvas midline, with clear space above and below. Keep the protected style's slight diagonal and intact outer sheath extending beyond the right edge. Aim for 80–90% occupied width where this preserves the compact bundle and every complete exposed tip.",
    "bundle": "Keep the exposed core group centered on the projected sheath axis. Preserve the real cross-sectional arrangement in depth. Avoid a descending diagonal staircase, planar fan or single-file row.",
    "stripping": "Assess stripping lengths along each local core axis. Keep comparable bare-metal exposure for peers in the same construction. Preserve distinct documented stripping steps and per-core coaxiality. Do not bend, independently stretch or move cores to make room.",
    "review": [
      "silhouette-centered-vertically",
      "core-group-balanced-around-sheath-axis",
      "no-diagonal-staircase",
      "all-metal-ends-complete-and-visible",
      "comparable-axial-stripping",
      "real-core-geometry-and-layer-roles"
    ]
  },
