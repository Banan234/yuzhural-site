# Safe production env template. Copy to a private file outside Git, for example:
# /etc/yuzhural-site/production.env
#
# Do not commit the copied file. Keep real SMTP passwords, VK tokens, runtime
# tokens, Sentry DSNs and supplier URLs in the private production env only.
#
# This template intentionally keeps secrets empty. `npm run check:env -- --production`
# must fail until required production secrets are filled.

# Express backend
NODE_ENV=production
PORT=3001

# Public canonical domain. Use https://yu-uek.ru or the current production
# domain, without a trailing slash. SITE_URL and VITE_SITE_URL must match.
SITE_URL=https://yu-uek.ru
VITE_SITE_URL=https://yu-uek.ru

# Forms in production have two valid modes:
# 1) Enabled forms: FORMS_ENABLED=true, FORMS_DELIVERY_MODE=smtp and all SMTP
#    fields below filled with working production values.
# 2) Temporarily disabled forms: FORMS_ENABLED=false. /api/quote and
#    /api/lead-request will return 503.
#
# FORMS_DELIVERY_MODE=local_file is only for dev/staging file outbox checks.
# It is forbidden in production.
# Recommended production SMTP for this project: Yandex 360 on your domain.
# Example:
#   FORMS_ENABLED=true
#   FORMS_DELIVERY_MODE=smtp
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=sale@yourdomain.ru
#   SMTP_PASS=<app password>
#   SMTP_FROM="ООО ЮжУралЭлектроКабель <sale@yourdomain.ru>"
#   QUOTE_TO_EMAIL=sale@yourdomain.ru
# See docs/yandex-360-smtp-setup.md for the full runbook.
FORMS_ENABLED=false
FORMS_DELIVERY_MODE=smtp
FORMS_LOCAL_OUTBOX_DIR=
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sale@yourdomain.ru
SMTP_PASS=
SMTP_FROM="ООО ЮжУралЭлектроКабель <sale@yourdomain.ru>"
QUOTE_TO_EMAIL=sale@yourdomain.ru
SMTP_POOL=true
SMTP_POOL_MAX_CONNECTIONS=2
SMTP_POOL_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_SEND_RETRIES=1
SMTP_RETRY_DELAY_MS=750

# VK bridge. Leave token/peer empty only if VK notifications and replies are
# intentionally disabled. If VK is enabled, callback must be a stable public
# HTTPS URL, not localhost and not a tunnel.
VK_COMMUNITY_ACCESS_TOKEN=
VK_MANAGER_PEER_ID=
VK_MANAGER_USER_IDS=
VK_CALLBACK_SECRET=
VK_CALLBACK_CONFIRMATION_TOKEN=
VK_CALLBACK_AUTO_CONFIGURE=false
VK_GROUP_ID=
VK_CALLBACK_URL=https://yu-uek.ru/api/vk/callback
VK_CALLBACK_SERVER_ID=
VK_CALLBACK_SERVER_TITLE=yuzhural-site
VK_CALLBACK_PUBLIC_PROBE_INTERVAL_MS=300000
VK_CALLBACK_ALLOW_INSECURE=false
VK_API_VERSION=5.131
# Set true only when VK bridge is intentionally disabled on this environment.
# Otherwise post-deploy smoke requires /api/vk/health?refresh=1 to be ready.
VK_SMOKE_ALLOW_DISABLED=false

# Required for post-deploy smoke and private runtime/VK diagnostics.
# Generate a long random value in the real production env, for example:
# openssl rand -hex 32
INTERNAL_METRICS_TOKEN=

# CORS can stay empty when frontend and API are served from the same domain.
ALLOWED_ORIGINS=
TRUSTED_PROXY_IPS=loopback

# Public frontend integrations. Keep empty to disable.
VITE_YANDEX_METRIKA_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Public contacts.
VITE_SITE_WHATSAPP_PHONE=79227230010
VITE_SITE_TELEGRAM_USERNAME=ocnuz
VITE_SITE_TELEGRAM_BUSINESS_CHAT_SLUG=
VITE_SITE_MESSENGER_PROMPT=Здравствуйте! Интересует кабельная продукция. Нужна консультация.

# Price import. Fill one source in the real production env if scheduled import
# should download supplier data automatically.
PRICE_URL=
PRICE_PAGE_URL=
PRICE_DOWNLOAD_MAX_BYTES=
PUBLIC_ARTIFACTS_DIR=
PRERENDER_TEMPLATE_DIR=
PRODUCT_PRERENDER_LIMIT=720
PRODUCT_PRERENDER_INCLUDE=

# Docker deploy.
DEPLOY_TAG=latest
APP_IMAGE=yuzhural-site-app
WEB_IMAGE=yuzhural-site-web
APP_ENV_FILE=/etc/yuzhural-site/production.env
DEPLOY_STATE_FILE=
WEB_HTTP_BIND=127.0.0.1:8080
ACCESS_LOG_SUCCESS_SAMPLE_RATE=0.1
ACCESS_LOG_SLOW_MS=1000
LOG_LEVEL=info
